# BUSY Bar: USB = 10.0.4.20 (no token). Cloud = https://api.busy.app + BUSY_TOKEN.
# Wi-Fi LAN: device IP + BUSY_HTTP_PASSWORD (Settings → HTTP Access).
BUSY_ADDR=https://api.busy.app
BUSY_TOKEN=
BUSY_HTTP_PASSWORD=

# LiveSplit: right click → Control → Start TCP Server
LIVESPLIT_HOST=127.0.0.1
LIVESPLIT_PORT=16834

POLL_MS=80
DRAW_PRIORITY=40
