# USB: BUSY_ADDR=10.0.4.20, leave token and password empty.
# Wi-Fi: BUSY_ADDR=<Bar LAN IP>, BUSY_HTTP_PASSWORD=<HTTP Access password>, leave BUSY_TOKEN empty.
# Cloud: BUSY_ADDR=https://api.busy.app + BUSY_TOKEN.
BUSY_ADDR=https://api.busy.app
BUSY_TOKEN=
BUSY_HTTP_PASSWORD=

# LiveSplit: right click → Control → Start TCP Server (or WebSocket Server)
LIVESPLIT_HOST=127.0.0.1
LIVESPLIT_PORT=16834
LIVESPLIT_PROTOCOL=auto

POLL_MS=80
DRAW_PRIORITY=40
